{
  "name": "output-manager",
  "version": "1.0.0",
  "description": "Switch Steam Gaming Mode's display and audio outputs from the Quick Access Menu.",
  "type": "module",
  "scripts": {
    "build": "shx rm -rf dist && rollup -c",
    "watch": "rollup -c -w"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeatethebeans/OutputManager"
  },
  "keywords": [
    "utility",
    "display",
    "audio",
    "outputs"
  ],
  "author": "joeatethebeans",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/joeatethebeans/OutputManager/issues"
  },
  "homepage": "https://github.com/joeatethebeans/OutputManager#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "shx": "^0.4.0",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
